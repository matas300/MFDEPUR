<%#
  Partial empty state riutilizzabile.
  Locals:
    icon    : 'box' | 'cart' | 'orders' | 'users' | 'search' | 'products' (default: 'box')
    title   : string
    message : string
    cta     : { href, label, primary?: bool }  opzionale
    cta2    : { href, label }                  opzionale
-%>
<% const _icons = {
  box:      '<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
  cart:     '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>',
  orders:   '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  users:    '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>',
  search:   '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  products: '<path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>',
}; const _icon = _icons[typeof icon !== 'undefined' ? icon : 'box'] || _icons.box; -%>
<div class="empty-state">
  <svg class="empty-state__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- _icon %></svg>
  <% if (typeof title !== 'undefined' && title) { %>
    <h3 class="empty-state__title"><%= title %></h3>
  <% } %>
  <% if (typeof message !== 'undefined' && message) { %>
    <p><%= message %></p>
  <% } %>
  <% if (typeof cta !== 'undefined' && cta) { %>
    <a href="<%= cta.href %>" class="btn btn-<%= cta.primary === false ? 'outline' : 'primary' %>"><%= cta.label %></a>
  <% } %>
  <% if (typeof cta2 !== 'undefined' && cta2) { %>
    <a href="<%= cta2.href %>" class="btn btn-outline"><%= cta2.label %></a>
  <% } %>
</div>
