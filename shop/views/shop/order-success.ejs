<%- include('../partials/_header', { title: 'Ordine confermato' }) %>

<div class="container">
  <div class="order-success">
    <div style="text-align:center;margin-bottom:2rem">
      <div style="font-size:4rem;margin-bottom:1rem">✅</div>
      <h1>Ordine confermato!</h1>
      <p style="color:var(--text-muted)">
        Grazie per il tuo ordine. Riceverai una conferma via email a breve.
      </p>
    </div>

    <% if (order.status === 'PENDING_PAYMENT' && typeof bank !== 'undefined' && bank) { %>
    <section class="bank-transfer-instructions" style="background:#f6f7f9;padding:1.5rem;border-radius:8px;margin:1.5rem 0;border-left:4px solid #0a3d8f">
      <h2 style="margin-top:0">Effettua il bonifico</h2>
      <p>Per completare l'ordine, esegui un bonifico ai dati indicati. Riceverai via email anche queste istruzioni. La spedizione partirà entro 2 giorni lavorativi dalla ricezione del pagamento.</p>
      <table style="width:100%;max-width:520px;border-collapse:collapse">
        <tr><td style="padding:.5rem;font-weight:600;width:140px">Beneficiario</td><td style="padding:.5rem"><%= bank.beneficiary %></td></tr>
        <tr><td style="padding:.5rem;font-weight:600">IBAN</td><td style="padding:.5rem"><code style="font-family:monospace"><%= bank.iban %></code></td></tr>
        <tr><td style="padding:.5rem;font-weight:600">Banca</td><td style="padding:.5rem"><%= bank.name %></td></tr>
        <% if (bank.bic) { %>
        <tr><td style="padding:.5rem;font-weight:600">BIC</td><td style="padding:.5rem"><%= bank.bic %></td></tr>
        <% } %>
        <tr><td style="padding:.5rem;font-weight:600">Causale</td><td style="padding:.5rem"><code style="font-family:monospace"><%= order.orderNumber %></code></td></tr>
        <tr><td style="padding:.5rem;font-weight:600">Importo</td><td style="padding:.5rem"><strong>€ <%= Number(order.total).toFixed(2) %></strong></td></tr>
      </table>
      <p style="font-size:.85rem;color:#666;margin-top:1rem">In caso di mancata ricezione del pagamento entro 7 giorni, l'ordine sarà annullato automaticamente.</p>
    </section>
    <% } %>

    <div class="order-detail-card">
      <div class="order-detail-header">
        <div>
          <h2>Ordine <%= order.orderNumber %></h2>
          <p style="color:var(--text-muted);margin:0">
            <%= new Date(order.createdAt).toLocaleDateString('it-IT', { day: '2-digit', month: 'long', year: 'numeric' }) %>
          </p>
        </div>
        <span class="order-status order-status--<%= order.status.toLowerCase() %>"><%= order.status %></span>
      </div>

      <% if (order.paymentMethod === 'BANK_TRANSFER') { %>
        <div class="alert alert-info" style="margin:1.5rem 0">
          <strong>Bonifico bancario</strong><br>
          Hai scelto il pagamento tramite bonifico. Troverai le coordinate bancarie nella email di conferma.
          L'ordine verrà processato dopo la ricezione del pagamento.
        </div>
      <% } %>

      <table class="order-items-table">
        <thead>
          <tr>
            <th scope="col">Prodotto</th>
            <th scope="col">SKU</th>
            <th scope="col">Qtà</th>
            <th scope="col">Prezzo unit.</th>
            <th scope="col">Totale</th>
          </tr>
        </thead>
        <tbody>
          <% order.items.forEach(item => { %>
            <tr>
              <td><strong><%= item.productName %></strong></td>
              <td><code><%= item.productSku %></code></td>
              <td><%= item.quantity %> <%= item.unit %></td>
              <td><%= formatEuro(item.unitPrice) %></td>
              <td><%= formatEuro(item.total) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" style="text-align:right">Subtotale</td>
            <td><%= formatEuro(order.subtotal) %></td>
          </tr>
          <tr>
            <td colspan="4" style="text-align:right">IVA 22%</td>
            <td><%= formatEuro(order.taxAmount) %></td>
          </tr>
          <% if (parseFloat(order.shippingCost) > 0) { %>
            <tr>
              <td colspan="4" style="text-align:right">Spedizione</td>
              <td><%= formatEuro(order.shippingCost) %></td>
            </tr>
          <% } %>
          <tr class="order-total-row">
            <td colspan="4" style="text-align:right"><strong>Totale</strong></td>
            <td><strong><%= formatEuro(order.total) %></strong></td>
          </tr>
        </tfoot>
      </table>

      <% if (order.address) { %>
        <div style="margin-top:1.5rem">
          <h4>Indirizzo di spedizione</h4>
          <address style="font-style:normal;color:var(--text-muted)">
            <%= order.company.name %><br>
            <%= order.address.street %><br>
            <%= order.address.postalCode %> <%= order.address.city %> (<%= order.address.province %>)
          </address>
        </div>
      <% } %>

      <% if (order.notes) { %>
        <div style="margin-top:1rem">
          <h4>Note</h4>
          <p style="color:var(--text-muted)"><%= order.notes %></p>
        </div>
      <% } %>
    </div>

    <div style="text-align:center;margin-top:2rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
      <a href="/account/orders" class="btn btn-outline">I miei ordini</a>
      <a href="/shop" class="btn btn-primary">Torna al catalogo</a>
    </div>
  </div>
</div>

<%- include('../partials/_footer') %>
