<%- include('../partials/_header', { title: 'Catalogo prodotti' }) %>

<!-- Hero banner -->
<div class="shop-hero">
  <div class="container">
    <h1><i class="fa-solid fa-flask"></i> Catalogo Prodotti</h1>
    <p>Soluzioni chimiche professionali per il trattamento delle acque industriali</p>
  </div>
</div>

<div class="container" style="padding-bottom:3rem">

  <nav class="breadcrumb" aria-label="breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <% if (filters.categoria) { %>
      <a href="/shop">Catalogo</a>
      <span>/</span>
      <% const activeCat = categories.find(c => c.slug === filters.categoria); %>
      <span><%= activeCat ? activeCat.name : filters.categoria %></span>
    <% } else { %>
      <span>Catalogo</span>
    <% } %>
  </nav>

  <% if (!currentUser) { %>
    <!-- Banner per utenti non registrati -->
    <div class="shop-guest-banner">
      <div>
        <strong>Scopri i prezzi riservati alle aziende</strong>
        <p>Registra la tua azienda gratuitamente per accedere ai prezzi B2B e ordinare online.</p>
      </div>
      <div class="shop-guest-banner-actions">
        <a href="/auth/register" class="btn-white">Registra azienda</a>
        <a href="/auth/login" class="btn-ghost">Accedi</a>
      </div>
    </div>
  <% } %>

  <div class="catalog-layout">
    <!-- Sidebar filtri -->
    <aside class="catalog-sidebar">
      <h3><i class="fa-solid fa-list"></i> Categorie</h3>
      <ul class="category-list">
        <li>
          <a href="/shop" class="<%= !filters.categoria ? 'active' : '' %>">
            Tutti i prodotti
          </a>
        </li>
        <% categories.forEach(cat => { %>
          <li>
            <a href="/shop?categoria=<%= cat.slug %>" class="<%= filters.categoria === cat.slug ? 'active' : '' %>">
              <%= cat.name %>
            </a>
          </li>
        <% }) %>
      </ul>

      <form action="/shop" method="GET" class="price-filter" style="padding:1rem;border-top:1px solid var(--border)">
        <h4 style="font-size:.85rem;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted);margin-bottom:.75rem">Filtra per prezzo</h4>
        <% if (filters.categoria) { %><input type="hidden" name="categoria" value="<%= filters.categoria %>"><% } %>
        <% if (filters.cerca) { %><input type="hidden" name="cerca" value="<%= filters.cerca %>"><% } %>
        <% if (filters.ordina && filters.ordina !== 'newest') { %><input type="hidden" name="ordina" value="<%= filters.ordina %>"><% } %>
        <div style="display:flex;gap:.5rem;margin-bottom:.5rem">
          <input type="number" name="pmin" min="0" step="0.01" placeholder="Min €" value="<%= filters.pmin %>" class="form-control" style="padding:6px 10px;font-size:.85rem" aria-label="Prezzo minimo">
          <input type="number" name="pmax" min="0" step="0.01" placeholder="Max €" value="<%= filters.pmax %>" class="form-control" style="padding:6px 10px;font-size:.85rem" aria-label="Prezzo massimo">
        </div>
        <button type="submit" class="btn btn-outline btn-sm btn-block">Applica</button>
        <% if (filters.pmin || filters.pmax) { %>
          <% const clearQs = new URLSearchParams({ ...(filters.categoria && { categoria: filters.categoria }), ...(filters.cerca && { cerca: filters.cerca }), ...(filters.ordina && filters.ordina !== 'newest' && { ordina: filters.ordina }) }).toString(); %>
          <a href="/shop<%= clearQs ? '?' + clearQs : '' %>" style="display:block;text-align:center;margin-top:.5rem;font-size:.8rem;color:var(--text-muted)">× Rimuovi filtro</a>
        <% } %>
      </form>

      <% if (currentUser && currentUser.company && currentUser.company.status === 'APPROVED') { %>
        <div style="padding:1rem;border-top:1px solid var(--border)">
          <a href="/shop/cart" class="btn btn-primary btn-block" style="border-radius:var(--r-full)">
            <i class="fa-solid fa-cart-shopping"></i>
            Carrello
            <% if (cartCount > 0) { %><span class="shop-cart-badge" style="position:static;border:none;margin-left:4px"><%= cartCount %></span><% } %>
          </a>
        </div>
      <% } %>
    </aside>

    <!-- Prodotti -->
    <div class="catalog-main">
      <!-- Barra di ricerca + ordinamento -->
      <form action="/shop" method="GET" class="search-bar">
        <% if (filters.categoria) { %><input type="hidden" name="categoria" value="<%= filters.categoria %>"><% } %>
        <% if (filters.pmin) { %><input type="hidden" name="pmin" value="<%= filters.pmin %>"><% } %>
        <% if (filters.pmax) { %><input type="hidden" name="pmax" value="<%= filters.pmax %>"><% } %>
        <input type="text" name="cerca" class="form-control" placeholder="Cerca prodotto, codice SKU..."
               value="<%= filters.cerca || '' %>">
        <select name="ordina" class="form-control js-auto-submit" style="max-width:200px" aria-label="Ordina per">
          <option value="newest"     <%= filters.ordina === 'newest' ? 'selected' : '' %>>Più recenti</option>
          <option value="price-asc"  <%= filters.ordina === 'price-asc' ? 'selected' : '' %>>Prezzo: crescente</option>
          <option value="price-desc" <%= filters.ordina === 'price-desc' ? 'selected' : '' %>>Prezzo: decrescente</option>
          <option value="name-asc"   <%= filters.ordina === 'name-asc' ? 'selected' : '' %>>Nome: A-Z</option>
        </select>
        <button type="submit" class="btn btn-primary">
          <i class="fa-solid fa-magnifying-glass"></i> Cerca
        </button>
        <% if (filters.cerca) { %>
          <% const cancelParams = new URLSearchParams({ ...(filters.categoria && { categoria: filters.categoria }), ...(filters.pmin && { pmin: filters.pmin }), ...(filters.pmax && { pmax: filters.pmax }), ...(filters.ordina && filters.ordina !== 'newest' && { ordina: filters.ordina }) }).toString(); %>
          <a href="/shop<%= cancelParams ? '?' + cancelParams : '' %>" class="btn btn-secondary">× Annulla</a>
        <% } %>
      </form>

      <% if (filters.cerca) { %>
        <p style="margin-bottom:1rem;color:var(--text-muted);font-size:.9rem">
          Risultati per "<strong><%= filters.cerca %></strong>" — <%= pagination.totalItems %> prodott<%= pagination.totalItems === 1 ? 'o' : 'i' %> trovati
        </p>
      <% } %>

      <% if (products.length === 0) { %>
        <%- include('../partials/_empty-state', {
          icon: filters.cerca ? 'search' : 'products',
          title: filters.cerca ? 'Nessun risultato per "' + filters.cerca + '"' : 'Nessun prodotto in questa categoria',
          message: filters.cerca
            ? 'Prova un altro termine di ricerca o rimuovi i filtri attivi.'
            : 'Al momento non ci sono prodotti che corrispondono ai filtri selezionati.',
          cta: { href: '/shop', label: 'Vedi tutti i prodotti' }
        }) %>
      <% } else { %>
        <div class="product-grid">
          <% products.forEach(product => { %>
            <div class="product-card">
              <a href="/shop/product/<%= product.slug %>" class="product-card-img">
                <% if (product.imageUrl) { %>
                  <img src="<%= product.imageUrl %>" alt="<%= product.name %>" loading="lazy">
                <% } else { %>
                  <div class="product-card-img-placeholder">
                    <i class="fa-solid fa-flask" style="font-size:2.5rem;color:var(--blue-200)"></i>
                  </div>
                <% } %>
                <% if (product.isFeatured) { %>
                  <span class="badge badge-featured">In evidenza</span>
                <% } %>
              </a>
              <div class="product-card-body">
                <div class="product-card-meta">
                  <% if (product.category) { %>
                    <span class="product-card-category"><%= product.category.name %></span>
                  <% } %>
                  <span class="product-card-sku">SKU: <%= product.sku %></span>
                </div>
                <h3 class="product-card-title">
                  <a href="/shop/product/<%= product.slug %>"><%= product.name %></a>
                </h3>
                <% if (product.shortDesc) { %>
                  <p class="product-card-desc"><%= product.shortDesc %></p>
                <% } %>
                <div class="product-card-footer">
                  <% if (product.priceOnRequest) { %>
                    <span class="product-card-price" style="font-size:.8rem;color:var(--text-muted);font-weight:600">Su richiesta</span>
                    <a href="mailto:info@mfdepur.com?subject=Preventivo: <%= encodeURIComponent(product.name) %>" class="btn btn-outline btn-sm">
                      Contattaci
                    </a>
                  <% } else { %>
                    <div class="product-card-price">
                      <%= formatEuro(product.price) %>
                      <small>/<%= product.unit %></small>
                    </div>
                    <% if (product.stock > 0) { %>
                      <% if (currentUser && currentUser.company && currentUser.company.status !== 'APPROVED') { %>
                        <span class="badge badge-gray" style="font-size:.72rem">Account in attesa</span>
                      <% } else { %>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px">
                          <button class="btn btn-primary btn-sm btn-add-cart"
                                  data-id="<%= product.id %>"
                                  data-qty="<%= product.minOrderQty %>"
                                  data-name="<%= product.name.replace(/"/g, '&quot;') %>"
                                  data-price="<%= parseFloat(product.price) %>"
                                  data-unit="<%= product.unit %>"
                                  data-img="<%= product.imageUrl || '' %>">
                            <i class="fa-solid fa-plus"></i> Carrello
                          </button>
                          <% if (product.minOrderQty > 1) { %>
                            <small style="color:var(--text-muted);font-size:.68rem">min. <%= product.minOrderQty %> <%= product.unit %></small>
                          <% } %>
                        </div>
                      <% } %>
                    <% } else { %>
                      <span class="badge badge-danger">Esaurito</span>
                    <% } %>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Paginazione -->
        <% if (pagination.total > 1) {
             const pageUrl = (p) => {
               const params = new URLSearchParams({
                 ...(filters.categoria && { categoria: filters.categoria }),
                 ...(filters.cerca && { cerca: filters.cerca }),
                 ...(filters.pmin && { pmin: filters.pmin }),
                 ...(filters.pmax && { pmax: filters.pmax }),
                 ...(filters.ordina && filters.ordina !== 'newest' && { ordina: filters.ordina }),
                 pagina: p,
               });
               return '/shop?' + params.toString();
             };
        %>
          <div class="pagination">
            <% if (pagination.current > 1) { %>
              <a href="<%= pageUrl(pagination.current - 1) %>" class="page-btn">&laquo;</a>
            <% } %>
            <% for (let i = 1; i <= pagination.total; i++) { %>
              <a href="<%= pageUrl(i) %>" class="page-btn <%= i === pagination.current ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <% if (pagination.current < pagination.total) { %>
              <a href="<%= pageUrl(pagination.current + 1) %>" class="page-btn">&raquo;</a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/_footer') %>
