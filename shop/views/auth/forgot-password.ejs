<%- include('../partials/_header', { title: 'Password dimenticata' }) %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo">
      <h1>Recupera password</h1>
      <p>Inserisci la tua email per ricevere il link di reset</p>
    </div>

    <% const _errs = (typeof errors !== 'undefined' && Array.isArray(errors)) ? errors : []; %>
    <% const _hasErr = (field) => _errs.some(e => e && (e.param === field || e.path === field)); %>
    <% if (_errs.length) { %>
      <div class="alert alert-danger" id="form-errors" role="alert">
        <% _errs.forEach(e => { %><div><%= e.msg %></div><% }) %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        Se l'email è registrata, riceverai un link per reimpostare la password.
      </div>
    <% } %>

    <form action="/auth/forgot-password" method="POST" class="auth-form" data-loading>
      <%- include('../partials/_csrf') %>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" class="form-control" data-validate="email" required autocomplete="email" inputmode="email" aria-invalid="<%= _hasErr('email') ? 'true' : 'false' %>"<% if (_errs.length) { %> aria-describedby="form-errors"<% } %>>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Invia link di reset</button>
    </form>

    <div class="auth-links">
      <a href="/auth/login">← Torna al login</a>
    </div>
  </div>
</div>

<%- include('../partials/_footer') %>
