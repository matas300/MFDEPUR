<%- include('../partials/_header', { title: 'Nuova password' }) %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo">
      <h1>Nuova password</h1>
      <p>Scegli una nuova password sicura</p>
    </div>

    <% const _errs = (typeof errors !== 'undefined' && Array.isArray(errors)) ? errors : []; %>
    <% const _hasErr = (field) => _errs.some(e => e && (e.param === field || e.path === field)); %>
    <% if (_errs.length) { %>
      <div class="alert alert-danger" id="form-errors" role="alert">
        <% _errs.forEach(e => { %><div><%= e.msg %></div><% }) %>
      </div>
    <% } %>

    <form action="/auth/reset-password" method="POST" class="auth-form" data-loading>
      <%- include('../partials/_csrf') %>
      <input type="hidden" name="token" value="<%= token %>">
      <div class="form-group">
        <label for="password">Nuova password <small>(min. 10 caratteri, 1 maiuscola, 1 minuscola, 1 numero)</small></label>
        <input type="password" id="password" name="password" class="form-control" minlength="10" required aria-invalid="<%= _hasErr('password') ? 'true' : 'false' %>"<% if (_errs.length) { %> aria-describedby="form-errors"<% } %>>
      </div>
      <div class="form-group">
        <label for="confirmPassword">Conferma password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" minlength="8" required aria-invalid="<%= _hasErr('confirmPassword') ? 'true' : 'false' %>"<% if (_errs.length) { %> aria-describedby="form-errors"<% } %>>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Imposta nuova password</button>
    </form>
  </div>
</div>

<%- include('../partials/_footer') %>
