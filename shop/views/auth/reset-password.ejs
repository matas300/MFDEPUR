<%- include('../partials/_header', { title: 'Nuova password' }) %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo">
      <h1>Nuova password</h1>
      <p>Scegli una nuova password sicura</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors.length) { %>
      <div class="alert alert-danger">
        <% errors.forEach(e => { %><div><%= e.msg %></div><% }) %>
      </div>
    <% } %>

    <form action="/auth/reset-password" method="POST" class="auth-form" data-loading>
      <input type="hidden" name="token" value="<%= token %>">
      <div class="form-group">
        <label for="password">Nuova password <small>(min. 8 caratteri)</small></label>
        <input type="password" id="password" name="password" class="form-control" minlength="8" required>
      </div>
      <div class="form-group">
        <label for="confirmPassword">Conferma password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" minlength="8" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Imposta nuova password</button>
    </form>
  </div>
</div>

<%- include('../partials/_footer') %>
