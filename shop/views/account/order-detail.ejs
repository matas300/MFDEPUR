<%- include('../partials/_header', { title: title }) %>

<div class="container">
  <nav class="breadcrumb">
    <a href="/account">Account</a>
    <span>/</span>
    <a href="/account/orders">I miei ordini</a>
    <span>/</span>
    <span><%= order.orderNumber %></span>
  </nav>

  <div class="print-header">
    <strong>MF Depur</strong> — Ricevuta ordine <%= order.orderNumber %><br>
    <small>www.mfdepur.com</small>
  </div>

  <div class="order-detail-card">
    <div class="order-detail-header">
      <div>
        <h1><%= order.orderNumber %></h1>
        <p style="color:var(--text-muted);margin:0">
          <%= new Date(order.createdAt).toLocaleDateString('it-IT', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
        </p>
      </div>
      <span class="order-status order-status--<%= order.status.toLowerCase() %>"><%= order.status %></span>
    </div>

    <%- include('../partials/_order-stepper', { order }) %>

    <% if (order.paymentMethod === 'BANK_TRANSFER' && order.status === 'CONFIRMED') { %>
      <div class="alert alert-info" style="margin:1.5rem 0">
        <strong>Bonifico bancario</strong> — In attesa di ricevere il pagamento.<br>
        <small>Coordinate bancarie inviate via email alla registrazione dell'ordine.</small>
      </div>
    <% } %>

    <table class="order-items-table">
      <thead>
        <tr>
          <th scope="col">Prodotto</th>
          <th scope="col">SKU</th>
          <th scope="col">Qtà</th>
          <th scope="col">Prezzo unit.</th>
          <th scope="col">Totale</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td><strong><%= item.productName %></strong></td>
            <td><code><%= item.productSku %></code></td>
            <td><%= item.quantity %> <%= item.unit %></td>
            <td><%= formatEuro(item.unitPrice) %></td>
            <td><%= formatEuro(item.total) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" style="text-align:right">Subtotale</td>
          <td><%= formatEuro(order.subtotal) %></td>
        </tr>
        <tr>
          <td colspan="4" style="text-align:right">IVA 22%</td>
          <td><%= formatEuro(order.taxAmount) %></td>
        </tr>
        <% if (parseFloat(order.shippingCost) > 0) { %>
          <tr>
            <td colspan="4" style="text-align:right">Spedizione</td>
            <td><%= formatEuro(order.shippingCost) %></td>
          </tr>
        <% } %>
        <tr class="order-total-row">
          <td colspan="4" style="text-align:right"><strong>Totale</strong></td>
          <td><strong><%= formatEuro(order.total) %></strong></td>
        </tr>
      </tfoot>
    </table>

    <div class="order-meta-grid">
      <% if (order.address) { %>
        <div>
          <h4>Spedizione a</h4>
          <address style="font-style:normal;color:var(--text-muted)">
            <%= order.company.name %><br>
            <%= order.address.street %><br>
            <%= order.address.postalCode %> <%= order.address.city %> (<%= order.address.province %>)
          </address>
        </div>
      <% } %>
      <div>
        <h4>Pagamento</h4>
        <p style="color:var(--text-muted)">
          <%= order.paymentMethod === 'STRIPE' ? 'Carta di credito/debito' : 'Bonifico bancario' %><br>
          <% if (order.paidAt) { %>
            Pagato il: <%= new Date(order.paidAt).toLocaleDateString('it-IT') %>
          <% } %>
        </p>
      </div>
      <% if (order.shippedAt) { %>
        <div>
          <h4>Spedito</h4>
          <p style="color:var(--text-muted)"><%= new Date(order.shippedAt).toLocaleDateString('it-IT') %></p>
        </div>
      <% } %>
      <% if (order.notes) { %>
        <div>
          <h4>Note ordine</h4>
          <p style="color:var(--text-muted)"><%= order.notes %></p>
        </div>
      <% } %>
    </div>
  </div>

  <div style="margin-top:1.5rem;display:flex;gap:.75rem;flex-wrap:wrap">
    <a href="/account/orders" class="btn btn-outline">← Tutti gli ordini</a>
    <button type="button" class="btn btn-outline" data-print>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Stampa
    </button>
  </div>
</div>

<%- include('../partials/_footer') %>
