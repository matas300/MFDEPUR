<%- include('../partials/_admin-header', { title: 'Dashboard' }) %>

<!-- Stats cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Ordini totali</div>
    <div class="stat-value"><%= stats.totalOrders %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Fatturato totale</div>
    <div class="stat-value">&euro;<%= parseFloat(stats.revenue || 0).toFixed(2) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Ordini questo mese</div>
    <div class="stat-value"><%= stats.ordersThisMonth %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Fatturato mese</div>
    <div class="stat-value">&euro;<%= parseFloat(stats.revenueMonth || 0).toFixed(2) %></div>
  </div>
  <div class="stat-card <%= stats.pendingCompanies > 0 ? 'stat-card--alert' : '' %>">
    <div class="stat-label">Aziende in attesa</div>
    <div class="stat-value"><%= stats.pendingCompanies %></div>
    <% if (stats.pendingCompanies > 0) { %>
      <a href="/admin/companies?stato=PENDING" class="stat-link">Rivedi &rarr;</a>
    <% } %>
  </div>
  <div class="stat-card">
    <div class="stat-label">Prodotti attivi</div>
    <div class="stat-value"><%= stats.totalProducts %></div>
  </div>
  <% if (lowStockProducts && lowStockProducts.length > 0) { %>
    <div class="stat-card stat-card--alert">
      <div class="stat-label">Stock basso</div>
      <div class="stat-value"><%= lowStockProducts.length %></div>
      <a href="/admin/products" class="stat-link">Vedi prodotti &rarr;</a>
    </div>
  <% } %>
</div>

<!-- Trend ordini/fatturato (ultimi 30 giorni) -->
<div class="admin-section">
  <div class="admin-section-header">
    <h2>Trend ultimi 30 giorni</h2>
  </div>
  <div style="position:relative;height:280px">
    <canvas id="trendChart" aria-label="Grafico trend ordini e fatturato" role="img"></canvas>
  </div>
</div>

<script id="chart-data" type="application/json" nonce="<%= cspNonce %>"><%- JSON.stringify(chartData) %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script nonce="<%= cspNonce %>">
(function () {
  const data = JSON.parse(document.getElementById('chart-data').textContent);
  const ctx = document.getElementById('trendChart');
  if (!ctx || !window.Chart) return;
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: data.labels,
      datasets: [
        {
          label: 'Ordini',
          data: data.orders,
          borderColor: '#1e40af',
          backgroundColor: 'rgba(30,64,175,.1)',
          yAxisID: 'y',
          tension: .3,
          fill: true,
        },
        {
          label: 'Fatturato (€)',
          data: data.revenue,
          borderColor: '#10b981',
          backgroundColor: 'rgba(16,185,129,.1)',
          yAxisID: 'y1',
          tension: .3,
          fill: true,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      scales: {
        y:  { type: 'linear', position: 'left',  title: { display: true, text: 'Ordini' }, beginAtZero: true, ticks: { precision: 0 } },
        y1: { type: 'linear', position: 'right', title: { display: true, text: 'Fatturato (€)' }, beginAtZero: true, grid: { drawOnChartArea: false } },
      },
    },
  });
})();
</script>

<!-- Ultimi ordini -->
<div class="admin-section">
  <div class="admin-section-header">
    <h2>Ultimi ordini</h2>
    <a href="/admin/orders" class="btn btn-outline btn-sm">Vedi tutti</a>
  </div>

  <% if (!recentOrders || recentOrders.length === 0) { %>
    <%- include('../partials/_empty-state', {
      icon: 'orders',
      title: 'Nessun ordine ancora',
      message: 'Gli ultimi ordini ricevuti compariranno qui non appena un cliente completerà un acquisto.'
    }) %>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Ordine</th>
          <th>Azienda</th>
          <th>Data</th>
          <th>Totale</th>
          <th>Stato</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% recentOrders.forEach(order => { %>
          <tr>
            <td><strong><%= order.orderNumber %></strong></td>
            <td><%= order.company.name %></td>
            <td><%= new Date(order.createdAt).toLocaleDateString('it-IT') %></td>
            <td>&euro;<%= parseFloat(order.total).toFixed(2) %></td>
            <td><span class="order-status order-status--<%= order.status.toLowerCase() %>"><%= order.status %></span></td>
            <td><a href="/admin/orders/<%= order.id %>" class="btn btn-outline btn-sm">Dettaglio</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/_admin-footer') %>
