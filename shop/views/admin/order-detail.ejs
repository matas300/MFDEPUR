<%- include('../partials/_admin-header', { title: title }) %>

<div class="admin-back" style="display:flex;gap:.5rem;flex-wrap:wrap">
  <a href="/admin/orders" class="btn btn-outline btn-sm">← Tutti gli ordini</a>
  <button type="button" class="btn btn-outline btn-sm" data-print>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    Stampa
  </button>
</div>

<div class="print-header">
  <strong>MF Depur</strong> — Ordine <%= order.orderNumber %> — copia amministrazione<br>
  <small><%= new Date(order.createdAt).toLocaleString('it-IT') %></small>
</div>

<div class="order-detail-grid">
  <!-- Dati ordine -->
  <div class="order-detail-card">
    <div class="order-detail-header">
      <div>
        <h2><%= order.orderNumber %></h2>
        <p style="color:var(--text-muted);margin:0">
          <%= new Date(order.createdAt).toLocaleString('it-IT') %>
        </p>
      </div>
      <span class="order-status order-status--<%= order.status.toLowerCase() %>"><%= order.status %></span>
    </div>

    <%- include('../partials/_order-stepper', { order }) %>

    <% if (order.status === 'AWAITING_APPROVAL') { %>
      <div class="alert alert-warning" style="margin:1rem 0">
        <h3 style="margin-top:0">Approvazione richiesta</h3>
        <p>Ordine creato da <strong><%= order.user.firstName %> <%= order.user.lastName %></strong> per <%= order.company.name %>. In attesa di approvazione del responsabile aziendale; in alternativa puoi forzare l'esito come admin.</p>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap">
          <form method="POST" action="/admin/orders/<%= order.id %>/approve" style="margin:0">
            <%- include('../partials/_csrf') %>
            <button type="submit" class="btn btn-primary">Approva (override)</button>
          </form>
          <form method="POST" action="/admin/orders/<%= order.id %>/reject" style="margin:0">
            <%- include('../partials/_csrf') %>
            <button type="submit" class="btn btn-outline">Rifiuta (override)</button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (order.status === 'PENDING_PAYMENT') { %>
      <div class="alert alert-info" style="margin:1rem 0">
        <h3 style="margin-top:0">In attesa di pagamento</h3>
        <p>Ordine in attesa di bonifico. Verifica l'estratto conto e marca come pagato quando il bonifico è ricevuto.</p>
        <button type="button" class="btn btn-primary js-open-mark-paid">Marca pagato</button>
      </div>
    <% } %>

    <table class="order-items-table">
      <thead>
        <tr>
          <th scope="col">Prodotto</th>
          <th scope="col">SKU</th>
          <th scope="col">Qtà</th>
          <th scope="col">Prezzo unit.</th>
          <th scope="col">Totale</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td><strong><%= item.productName %></strong></td>
            <td><code><%= item.productSku %></code></td>
            <td><%= item.quantity %> <%= item.unit %></td>
            <td><%= formatEuro(item.unitPrice) %></td>
            <td><%= formatEuro(item.total) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr><td colspan="4" style="text-align:right">Subtotale</td><td><%= formatEuro(order.subtotal) %></td></tr>
        <tr><td colspan="4" style="text-align:right">IVA 22%</td><td><%= formatEuro(order.taxAmount) %></td></tr>
        <% if (parseFloat(order.shippingCost) > 0) { %>
          <tr><td colspan="4" style="text-align:right">Spedizione</td><td><%= formatEuro(order.shippingCost) %></td></tr>
        <% } %>
        <tr class="order-total-row">
          <td colspan="4" style="text-align:right"><strong>Totale</strong></td>
          <td><strong><%= formatEuro(order.total) %></strong></td>
        </tr>
      </tfoot>
    </table>

    <div class="order-meta-grid" style="margin-top:1.5rem">
      <div>
        <h4>Azienda</h4>
        <p><a href="/admin/companies/<%= order.company.id %>"><%= order.company.name %></a><br>
        <span style="color:var(--text-muted)">P.IVA: <%= order.company.vatNumber %></span></p>
      </div>
      <div>
        <h4>Cliente</h4>
        <p><%= order.user.firstName %> <%= order.user.lastName %><br>
        <a href="mailto:<%= order.user.email %>"><%= order.user.email %></a></p>
      </div>
      <div>
        <h4>Pagamento</h4>
        <p><%= order.paymentMethod === 'STRIPE' ? 'Carta di credito/debito' : 'Bonifico bancario' %>
        <% if (order.paidAt) { %><br><span style="color:var(--text-muted)">Pagato: <%= new Date(order.paidAt).toLocaleDateString('it-IT') %></span><% } %>
        <% if (order.paymentIntentId) { %><br><small style="color:var(--text-muted)">PI: <%= order.paymentIntentId %></small><% } %></p>
      </div>
      <% if (order.address) { %>
        <div>
          <h4>Spedizione a</h4>
          <address style="font-style:normal">
            <%= order.address.street %><br>
            <%= order.address.postalCode %> <%= order.address.city %> (<%= order.address.province %>)
          </address>
        </div>
      <% } %>
      <% if (order.notes) { %>
        <div>
          <h4>Note</h4>
          <p style="color:var(--text-muted)"><%= order.notes %></p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Aggiorna stato -->
  <div class="admin-sidebar-panel">
    <h3>Aggiorna stato</h3>
    <form action="/admin/orders/<%= order.id %>/status" method="POST">
      <%- include('../partials/_csrf') %>
      <div class="form-group">
        <select name="status" class="form-control">
          <% ['PENDING','CONFIRMED','PROCESSING','SHIPPED','DELIVERED','CANCELLED','REFUNDED'].forEach(s => { %>
            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="trackingCarrier">Vettore</label>
        <select name="trackingCarrier" id="trackingCarrier" class="form-control">
          <option value="">— Nessuno —</option>
          <% (typeof carriers !== 'undefined' ? carriers : []).forEach(c => { %>
            <option value="<%= c %>" <%= order.trackingCarrier === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="trackingNumber">Numero tracking</label>
        <input type="text" name="trackingNumber" id="trackingNumber" class="form-control" maxlength="100" value="<%= order.trackingNumber || '' %>">
      </div>
      <div class="form-group">
        <label for="trackingUrl">URL tracking (opzionale, https://)</label>
        <input type="url" name="trackingUrl" id="trackingUrl" class="form-control" maxlength="500" value="<%= order.trackingUrl || '' %>">
        <small>Lasciare vuoto per generazione automatica dai vettori noti.</small>
      </div>
      <% if (order.trackingUrl) { %>
        <p><a href="<%= order.trackingUrl %>" target="_blank" rel="noopener noreferrer">Apri pagina tracking del vettore</a></p>
      <% } %>
      <div class="form-group">
        <label for="adminNotes">Note interne (opzionale)</label>
        <textarea name="adminNotes" id="adminNotes" class="form-control" rows="3"></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Aggiorna stato</button>
    </form>

  </div>
</div>

<% if (order.status === 'PENDING_PAYMENT') { %>
  <%- include('./_mark-paid-modal', { order }) %>
<% } %>

<%- include('../partials/_admin-footer') %>
