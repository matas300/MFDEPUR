<%- include('../partials/_admin-header', { title: 'Ordini' }) %>

<%
  const statoSel = Array.isArray(filters.stato) ? filters.stato : [];
  const hasFilters = statoSel.length > 0 || filters.azienda || filters.dal || filters.al;
  // Costruisce URL export con gli stessi filtri correnti
  const _qp = new URLSearchParams();
  statoSel.forEach(s => _qp.append('stato', s));
  if (filters.azienda) _qp.set('azienda', filters.azienda);
  if (filters.dal) _qp.set('dal', filters.dal);
  if (filters.al) _qp.set('al', filters.al);
  const exportUrl = '/admin/orders/export.csv' + (_qp.toString() ? ('?' + _qp.toString()) : '');
%>

<div class="admin-section-header">
  <form action="/admin/orders" method="GET" class="admin-filters">
    <div class="admin-filters__row">
      <div class="admin-filters__group">
        <label class="form-label form-label--sm">Stato</label>
        <div class="checkbox-pills" role="group" aria-label="Filtra per stato">
          <% statuses.forEach(s => {
               const checked = statoSel.includes(s);
          %>
            <label class="checkbox-pill <%= checked ? 'is-checked' : '' %>">
              <input type="checkbox" name="stato" value="<%= s %>" <%= checked ? 'checked' : '' %>>
              <span><%= s %></span>
            </label>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="admin-filters__row">
      <div class="admin-filters__group">
        <label for="f-azienda" class="form-label form-label--sm">Azienda</label>
        <input id="f-azienda" type="text" name="azienda" class="form-control form-control--sm"
               placeholder="Nome azienda..." value="<%= filters.azienda || '' %>">
      </div>
      <div class="admin-filters__group">
        <label for="f-dal" class="form-label form-label--sm">Dal</label>
        <input id="f-dal" type="date" name="dal" class="form-control form-control--sm" value="<%= filters.dal || '' %>">
      </div>
      <div class="admin-filters__group">
        <label for="f-al" class="form-label form-label--sm">Al</label>
        <input id="f-al" type="date" name="al" class="form-control form-control--sm" value="<%= filters.al || '' %>">
      </div>
      <div class="admin-filters__actions">
        <button type="submit" class="btn btn-primary btn-sm">Applica filtri</button>
        <% if (hasFilters) { %>
          <a href="/admin/orders" class="btn btn-outline btn-sm">Reset</a>
        <% } %>
        <a href="<%= exportUrl %>" class="btn btn-outline btn-sm" download>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Esporta CSV
        </a>
      </div>
    </div>

    <% if (typeof totalCount !== 'undefined') { %>
      <div class="admin-filters__summary">
        <%= totalCount %> ordin<%= totalCount === 1 ? 'e' : 'i' %> <%= hasFilters ? 'corrispondenti ai filtri' : 'totali' %>
      </div>
    <% } %>
  </form>
</div>

<% if (!orders || orders.length === 0) { %>
  <%- include('../partials/_empty-state', {
    icon: 'orders',
    title: hasFilters ? 'Nessun ordine per questi filtri' : 'Nessun ordine ancora',
    message: hasFilters
      ? 'Prova a modificare o rimuovere i filtri per vedere più risultati.'
      : 'Gli ordini ricevuti compariranno qui appena un cliente completerà un acquisto.',
    cta: hasFilters ? { href: '/admin/orders', label: 'Rimuovi filtri', primary: false } : null
  }) %>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Ordine</th>
        <th scope="col">Azienda</th>
        <th scope="col">Data</th>
        <th scope="col">Articoli</th>
        <th scope="col">Totale</th>
        <th scope="col">Pagamento</th>
        <th scope="col">Stato</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(order => { %>
        <tr>
          <td><strong><%= order.orderNumber %></strong></td>
          <td><a href="/admin/companies/<%= order.companyId %>"><%= order.company.name %></a></td>
          <td><%= new Date(order.createdAt).toLocaleDateString('it-IT') %></td>
          <td><%= order._count ? order._count.items : '—' %></td>
          <td><strong>&euro;<%= parseFloat(order.total).toFixed(2) %></strong></td>
          <td><%= order.paymentMethod === 'STRIPE' ? 'Carta' : 'Bonifico' %></td>
          <td><span class="order-status order-status--<%= order.status.toLowerCase() %>"><%= order.status %></span></td>
          <td><a href="/admin/orders/<%= order.id %>" class="btn btn-outline btn-sm">Apri</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (pagination && pagination.total > 1) { %>
    <nav class="pagination" aria-label="Paginazione">
      <% for (let p = 1; p <= pagination.total; p++) {
           const pq = new URLSearchParams();
           statoSel.forEach(s => pq.append('stato', s));
           if (filters.azienda) pq.set('azienda', filters.azienda);
           if (filters.dal) pq.set('dal', filters.dal);
           if (filters.al) pq.set('al', filters.al);
           pq.set('pagina', p);
      %>
        <a href="/admin/orders?<%= pq.toString() %>" class="pagination__link <%= p === pagination.current ? 'is-current' : '' %>"><%= p %></a>
      <% } %>
    </nav>
  <% } %>
<% } %>

<%- include('../partials/_admin-footer') %>
