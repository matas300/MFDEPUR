{
  "name": "mfdepur-shop",
  "version": "1.0.0",
  "description": "MF Depur — B2B Shop",
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^8.55.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.5",
    "stripe": "^14.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.3",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  }
}
